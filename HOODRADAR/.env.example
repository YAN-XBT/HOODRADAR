# .env.example — copy to .env and fill (never commit .env)

# Birdeye API key (Dashboard → Security)
# https://docs.birdeye.so/
BIRDEYE=

# Optional alias names also accepted by scripts:
# BIRDEYE_API_KEY=
# BIRDEYE_KEY=

# GMGN is usually configured via:
#   gmgn-cli config --apply 'YOUR_KEY'
# which writes ~/.config/gmgn/.env
# You can also place:
# GMGN_API_KEY=
